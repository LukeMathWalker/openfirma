common --enable_bzlmod

# Optional local/CI credentials and metadata for the BuildBuddy remote cache.
# This file must not be checked in; CI generates it from BUILD_BUDDY_API_KEY.
try-import %workspace%/.bazelrc.buildbuddy.auth

# Keep Bazel outputs out of source directories unless explicitly requested.
build --experimental_convenience_symlinks=ignore

# Match the existing Cargo build.rs contract for protobuf crates: protoc is a
# system tool discovered on PATH, or via PROTOC when CI exports an explicit path.
build --action_env=PATH
build --action_env=PROTOC

# Opt-in remote caching via `bazel --config=buildbuddy ...` or
# `BAZEL_FLAGS=--config=buildbuddy just bazel-check`.
build:buildbuddy --bes_results_url=https://app.buildbuddy.io/invocation/
build:buildbuddy --bes_backend=grpcs://remote.buildbuddy.io
build:buildbuddy --noslim_profile
build:buildbuddy --experimental_profile_include_target_label
build:buildbuddy --experimental_profile_include_primary_output
common:buildbuddy --remote_cache=grpcs://remote.buildbuddy.io
common:buildbuddy --remote_cache_compression
common:buildbuddy --remote_download_minimal
common:buildbuddy --remote_timeout=10m
