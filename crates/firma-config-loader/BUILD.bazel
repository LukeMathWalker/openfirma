load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "firma_config_loader",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = [
        "clap",
        "test-utils",
    ],
    crate_name = "firma_config_loader",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(normal = True),
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "unit_tests",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":firma_config_loader",
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

rust_test(
    name = "integration_tests",
    srcs = glob(["tests/integration/**/*.rs"]),
    aliases = aliases(
        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    args = ["--test-threads=1"],
    crate_name = "firma_config_loader_integration_tests",
    crate_root = "tests/integration/main.rs",
    deps = all_crate_deps(normal = True) + all_crate_deps(normal_dev = True) + [":firma_config_loader"],
    edition = crate_edition(),
    env = {
        "NEXTEST": "1",
    },
    proc_macro_deps = all_crate_deps(proc_macro = True) + all_crate_deps(proc_macro_dev = True),
)

rust_doc_test(
    name = "doc_tests",
    crate = ":firma_config_loader",
)

rust_doc(
    name = "docs",
    crate = ":firma_config_loader",
)

exports_files(["Cargo.toml"])
