load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test")
load("@rules_rust_prost//:defs.bzl", "rust_prost_library")

package(default_visibility = ["//visibility:public"])

PROTO_SRCS = glob(["proto/**/*.proto"])

BAZEL_CFG = ["--cfg=bazel"]

proto_library(
    name = "firma_interceptor_v1_proto",
    srcs = PROTO_SRCS,
    strip_import_prefix = "proto",
)

rust_prost_library(
    name = "firma_interceptor_v1_proto_rust",
    proto = ":firma_interceptor_v1_proto",
)

rust_library(
    name = "firma_grpc_interceptor_proto",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "firma_grpc_interceptor_proto",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(normal = True) + [":firma_interceptor_v1_proto_rust"],
    edition = "2024",
    rustc_flags = BAZEL_CFG,
)

alias(
    name = "firma-grpc-interceptor-proto",
    actual = ":firma_grpc_interceptor_proto",
)

rust_doc_test(
    name = "doc_tests",
    crate = ":firma_grpc_interceptor_proto",
    rustdoc_flags = BAZEL_CFG,
)

rust_doc(
    name = "docs",
    crate = ":firma_grpc_interceptor_proto",
    rustdoc_flags = BAZEL_CFG,
)

exports_files(["Cargo.toml"] + PROTO_SRCS)
