load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "firma_runtime_state",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "firma_runtime_state",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(normal = True),
    edition = "2024",
)

alias(
    name = "firma-runtime-state",
    actual = ":firma_runtime_state",
)

rust_test(
    name = "unit_tests",
    aliases = aliases(),
    crate = ":firma_runtime_state",
    edition = "2024",
    deps = all_crate_deps(normal_dev = True),
)

rust_test(
    name = "runtime_paths_integration_test",
    srcs = ["tests/runtime_paths.rs"],
    aliases = aliases(),
    crate_name = "runtime_paths_integration_test",
    deps = all_crate_deps(normal = True, normal_dev = True) + [":firma_runtime_state"],
    edition = "2024",
)

rust_test(
    name = "sidecar_markers_integration_test",
    srcs = ["tests/sidecar_markers.rs"],
    aliases = aliases(),
    crate_name = "sidecar_markers_integration_test",
    deps = all_crate_deps(normal = True, normal_dev = True) + [":firma_runtime_state"],
    edition = "2024",
)

rust_test(
    name = "process_id_integration_test",
    srcs = ["tests/process_id.rs"],
    aliases = aliases(),
    crate_name = "process_id_integration_test",
    deps = all_crate_deps(normal = True, normal_dev = True) + [":firma_runtime_state"],
    edition = "2024",
)

rust_test(
    name = "state_dir_resolution_integration_test",
    srcs = ["tests/state_dir_resolution.rs"],
    aliases = aliases(),
    crate_name = "state_dir_resolution_integration_test",
    deps = all_crate_deps(normal = True, normal_dev = True) + [":firma_runtime_state"],
    edition = "2024",
)

rust_test(
    name = "pidfile_roundtrip_integration_test",
    srcs = ["tests/pidfile_roundtrip.rs"],
    aliases = aliases(),
    crate_name = "pidfile_roundtrip_integration_test",
    deps = all_crate_deps(normal = True, normal_dev = True) + [":firma_runtime_state"],
    edition = "2024",
)

rust_doc_test(
    name = "doc_tests",
    crate = ":firma_runtime_state",
)

rust_doc(
    name = "docs",
    crate = ":firma_runtime_state",
)

exports_files(["Cargo.toml"])
