load("//bazel:rust_tests.bzl", "cargo_integration_test")
load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "firma",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(["templates/**"]),
    crate_name = "firma",
    crate_root = "src/main.rs",
    deps = all_crate_deps(normal = True) + [
        "//crates/firma-authority:firma_authority",
        "//crates/firma-config-loader:firma_config_loader",
        "//crates/firma-core:firma_core",
        "//crates/firma-run:firma_run",
        "//crates/firma-runtime-state:firma_runtime_state",
        "//crates/firma-sidecar:firma_sidecar",
        "//crates/firma-stack:firma_stack",
    ],
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = "0.1.2",
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(
        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    compile_data = glob(["templates/**"]),
    crate_name = "firma_test",
    crate_root = "src/main.rs",
    deps = all_crate_deps(normal = True) + all_crate_deps(normal_dev = True) + [
        "//crates/firma-authority:firma_authority",
        "//crates/firma-config-loader:firma_config_loader",
        "//crates/firma-core:firma_core",
        "//crates/firma-run:firma_run",
        "//crates/firma-runtime-state:firma_runtime_state",
        "//crates/firma-sidecar:firma_sidecar",
        "//crates/firma-stack:firma_stack",
    ],
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro = True) + all_crate_deps(proc_macro_dev = True),
    version = "0.1.2",
)

rust_test(
    name = "cli_help_test",
