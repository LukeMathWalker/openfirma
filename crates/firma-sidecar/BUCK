    "//third-party:tokio",
]

genrule(
    name = "firma-sidecar-manifest-dir",
    srcs = MAPPING_SRCS,
    out = "manifest_dir",
    cmd = "mkdir -p $OUT/config/mappings && cp $SRCS $OUT/config/mappings/",
)

