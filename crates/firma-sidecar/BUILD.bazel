load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_doc", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "firma_sidecar",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "firma_sidecar",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(normal = True) + [
        "//crates/firma-core:firma_core",
        "//crates/firma-grpc-interceptor-proto:firma_grpc_interceptor_proto",
        "//crates/firma-protobuf:firma_protobuf",
        "//crates/firma-runtime-state:firma_runtime_state",
    ],
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "unit_tests",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":firma_sidecar",
    data = glob(["config/mappings/*.toml"]),
    deps = all_crate_deps(normal_dev = True),
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    rustc_env = {
        "CARGO_MANIFEST_DIR": "crates/firma-sidecar",
    },
)

rust_doc_test(
    name = "doc_tests",
    crate = ":firma_sidecar",
)

rust_doc(
    name = "docs",
    crate = ":firma_sidecar",
)

_BENCH_DEPS = all_crate_deps(normal = True) + all_crate_deps(normal_dev = True) + [
    ":firma_sidecar",
    "//crates/firma-core:firma_core",
]

_BENCH_FIXTURES = glob(["benches/fixtures/*"])

rust_binary(
    name = "revocation_bench",
    srcs = ["benches/revocation.rs"],
    aliases = aliases(
        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    crate_name = "revocation_bench",
    crate_root = "benches/revocation.rs",
    deps = _BENCH_DEPS,
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro = True) + all_crate_deps(proc_macro_dev = True),
)

rust_binary(
    name = "cedar_eval_bench",
    srcs = [
        "benches/cedar_eval.rs",
        "benches/support/common_fixtures.rs",
    ],
    aliases = aliases(
        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    compile_data = _BENCH_FIXTURES,
    crate_name = "cedar_eval_bench",
    crate_root = "benches/cedar_eval.rs",
    deps = _BENCH_DEPS,
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro = True) + all_crate_deps(proc_macro_dev = True),
)

rust_binary(
    name = "bundle_reload_bench",
    srcs = [
        "benches/bundle_reload.rs",
        "benches/support/common_fixtures.rs",
    ],
    aliases = aliases(
        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    compile_data = _BENCH_FIXTURES,
    crate_name = "bundle_reload_bench",
    crate_root = "benches/bundle_reload.rs",
    deps = _BENCH_DEPS,
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro = True) + all_crate_deps(proc_macro_dev = True),
)

rust_binary(
    name = "stage1_bench",
    srcs = ["benches/stage1.rs"],
    aliases = aliases(
        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    crate_name = "stage1_bench",
    crate_root = "benches/stage1.rs",
    deps = _BENCH_DEPS,
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro = True) + all_crate_deps(proc_macro_dev = True),
)

rust_binary(
    name = "pipeline_bench",
    srcs = [
        "benches/pipeline.rs",
        "benches/support/common_fixtures.rs",
    ],
    aliases = aliases(
        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    compile_data = _BENCH_FIXTURES,
    crate_name = "pipeline_bench",
    crate_root = "benches/pipeline.rs",
    deps = _BENCH_DEPS,
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro = True) + all_crate_deps(proc_macro_dev = True),
)

exports_files(["Cargo.toml"])
