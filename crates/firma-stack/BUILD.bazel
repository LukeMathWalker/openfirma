load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "firma_stack",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "firma_stack",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(normal = True) + [
        "//crates/firma-config-loader:firma_config_loader",
        "//crates/firma-runtime-state:firma_runtime_state",
    ],
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "unit_tests",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":firma_stack",
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

rust_test(
    name = "config_parse_integration_test",
    srcs = ["tests/config_parse.rs"],
    aliases = aliases(
        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    crate_name = "config_parse_integration_test",
    deps = all_crate_deps(normal = True) + all_crate_deps(normal_dev = True) + [
        ":firma_stack",
        "//crates/firma-config-loader:firma_config_loader",
    ],
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro = True) + all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "status_state_machine_integration_test",
    srcs = ["tests/status_state_machine.rs"],
    aliases = aliases(
        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    crate_name = "status_state_machine_integration_test",
    deps = all_crate_deps(normal = True) + all_crate_deps(normal_dev = True) + [":firma_stack"],
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro = True) + all_crate_deps(proc_macro_dev = True),
)

rust_doc_test(
    name = "doc_tests",
    crate = ":firma_stack",
)

rust_doc(
    name = "docs",
    crate = ":firma_stack",
)

exports_files(["Cargo.toml"])
