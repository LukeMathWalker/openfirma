load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "firma_stack",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "firma_stack",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(normal = True) + [
        "//crates/firma-config-loader:firma_config_loader",
        "//crates/firma-runtime-state:firma_runtime_state",
    ],
    edition = "2024",
)

alias(
    name = "firma-stack",
    actual = ":firma_stack",
)

rust_test(
    name = "unit_tests",
    aliases = aliases(),
    crate = ":firma_stack",
    edition = "2024",
    deps = all_crate_deps(normal_dev = True),
)

rust_test(
    name = "config_parse_integration_test",
    srcs = ["tests/config_parse.rs"],
    aliases = aliases(),
    crate_name = "config_parse_integration_test",
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        ":firma_stack",
        "//crates/firma-config-loader:firma_config_loader",
    ],
    edition = "2024",
)

rust_test(
    name = "status_state_machine_integration_test",
    srcs = ["tests/status_state_machine.rs"],
    aliases = aliases(),
    crate_name = "status_state_machine_integration_test",
    deps = all_crate_deps(normal = True, normal_dev = True) + [":firma_stack"],
    edition = "2024",
)

rust_doc_test(
    name = "doc_tests",
    crate = ":firma_stack",
)

rust_doc(
    name = "docs",
    crate = ":firma_stack",
)

exports_files(["Cargo.toml"])
