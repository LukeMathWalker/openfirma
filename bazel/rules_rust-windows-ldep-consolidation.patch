+/// On Windows, rustc adds dependency search paths to PATH when loading crates.
+/// Large Bazel Rust actions can exceed the Windows environment-variable limit,
+/// causing rustc to report that direct crates cannot be found. Consolidate many
+/// dependency search directories into one staging directory before invoking rustc.
+#[cfg(windows)]
+fn consolidate_ldeps(
+    ldep_paths: &[String],
+    param_file: &str,
+) -> Result<Option<String>, OptionError> {
+    // Keep small actions unchanged; the failing cases have hundreds of entries.
+    if ldep_paths.len() < 300 {
+        return Ok(None);
+    }
+
+    let consolidated_dir = format!("{param_file}.ldeps");
+    let _ = std::fs::remove_dir_all(&consolidated_dir);
+    std::fs::create_dir_all(&consolidated_dir).map_err(|e| {
+        OptionError::Generic(format!("failed to create {consolidated_dir}: {e}"))
+    })?;
+
+    for dir in ldep_paths {
+        let entries = match std::fs::read_dir(dir) {
+            Ok(entries) => entries,
+            Err(_) => continue,
+        };
+
+        for entry in entries.flatten() {
+            let path = entry.path();
+            if !path.is_file() {
+                continue;
+            }
+
+            let Some(name) = path.file_name() else {
+                continue;
+            };
+            let target = std::path::Path::new(&consolidated_dir).join(name);
+            if target.exists() {
+                continue;
+            }
+
+            if std::fs::hard_link(&path, &target).is_err() {
+                std::fs::copy(&path, &target).map_err(|e| {
+                    OptionError::Generic(format!(
+                        "failed to stage {path:?} into ldeps directory: {e}"
+                    ))
+                })?;
+            }
+        }
+    }
+
+    Ok(Some(consolidated_dir))
+}
+
+#[cfg(not(windows))]
+fn consolidate_ldeps(
+    _ldep_paths: &[String],
+    _param_file: &str,
+) -> Result<Option<String>, OptionError> {
+    Ok(None)
+}
